{
  "name": "themeflow",
  "version": "1.1.0",
  "description": "ThemeFlow — A Premium Codeforces Theme Studio Chrome Extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "inspect": "node scripts/inspect-images.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:sounds": "node scripts/generate-sounds.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx scripts/test-celebration.mjs && npx tsx scripts/test-phase1-phase2.mjs && npx tsx scripts/test-phase3-controllers.mjs",
    "build": "node scripts/inspect-images.mjs && node scripts/generate-icons.mjs && node scripts/generate-sounds.mjs && node scripts/build.mjs && node scripts/verify-assets.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamdevdhanush/ThemeFlow.git"
  },
  "keywords": [
    "chrome-extension",
    "codeforces",
    "themes",
    "customizer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/chrome": "^0.0.312",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
